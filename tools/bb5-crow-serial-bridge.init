#!/bin/sh /etc/rc.common

# BB5MC deployment helper: expose the USB Companion as a local TCP stream.
# The Crow package remains generic; this service is intentionally node-local.

START=97
STOP=10
USE_PROCD=1

start_service()
{
    procd_open_instance
    procd_set_param command /usr/local/crow/crow-serial-bridge
    # BB5's RAK4631 currently identifies as 239a:8029. The resolver matches
    # this identity first and falls back only when exactly one ttyACM exists.
    procd_set_param env CROW_SERIAL_USB_ID=239a:8029
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
