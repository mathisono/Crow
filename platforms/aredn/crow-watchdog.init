#!/bin/sh /etc/rc.common
# Restart Crow when its process disappears or its event loop stops updating.

START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/local/crow/platforms/aredn/crow-watchdog.sh --loop
    procd_set_param respawn 3600 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
