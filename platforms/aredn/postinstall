#!/bin/sh
# Remove legacy auto-update cron jobs
rm -f /etc/cron.daily/raven-update /etc/cron.daily/crow-update

# Create Crow data directories
mkdir -p /usr/local/crow/data
mkdir -p /usr/local/crow/winlink/forms
mkdir -p /tmp/apps/crow/images

# Import selected legacy Raven settings/data only when Crow state is missing.
if [ -x /usr/local/crow/platforms/aredn/crow-migrate-raven.sh ]; then
    /usr/local/crow/platforms/aredn/crow-migrate-raven.sh
fi

# Migrate temporary image cache if present.
if [ -d /tmp/apps/raven/images ] && [ -z "$(ls -A /tmp/apps/crow/images 2>/dev/null)" ]; then
    cp -an /tmp/apps/raven/images/* /tmp/apps/crow/images/ 2>/dev/null
fi

/etc/init.d/crow enable
/etc/init.d/crow start
/etc/init.d/crow-watchdog enable
/etc/init.d/crow-watchdog start
if [ -x /etc/local/mesh-firewall/21-crow ]; then
    /etc/local/mesh-firewall/21-crow
fi

exit 0
