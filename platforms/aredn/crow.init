#!/bin/sh /etc/rc.common
# Crow mesh messaging service init script
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/ucode -L /usr/local/crow /usr/local/crow/crow.uc
    # Keep retrying after a crash.  AREDN nodes are unattended and a transient
    # radio/module failure should not leave Crow stopped after five attempts.
    # The separate crow-watchdog service handles a live but wedged event loop.
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    echo "Stopping Crow..."
}
