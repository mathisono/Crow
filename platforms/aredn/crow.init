#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=19

start_service()
{
    procd_open_instance crow
    procd_set_param command ucode -L /usr/local/crow /usr/local/crow/router.uc
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param user root
    procd_set_param pidfile /var/run/crow.pid
    procd_set_param term_timeout 60
    procd_close_instance
}

stop_service() {
    kill -1 $(cat /var/run/crow.pid)
    while pidof router.uc > /dev/null; do sleep 1; done
}

restart() {
    stop
    start
}
