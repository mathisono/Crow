#!/bin/sh /etc/rc.common
# Crow mesh messaging service init script
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/local/crow/platforms/aredn/crow-runner.sh
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_close_instance
}

stop_service() {
    echo "Stopping Crow..."
}
